Step 2: Scheduler script (System → Scheduler) 
System  Schedule e Interval time jeta ami set korbo oi time por por ei Scrept dekhbe je jar jar validity ses hoiche tak take disable kore dibe 

 
:foreach u in=[/ip hotspot user find where comment!="" disabled=no] do={
  :local uname [/ip hotspot user get $u name];
  :local prof [/ip hotspot user get $u profile];
  :local c [/ip hotspot user get $u comment];
  :local v 0s;
  :if ($prof="Profile-7d") do={:set v 7d};
  :if ($prof="Profile-30d") do={:set v 30d};
  :if ($v > 0s) do={
    :do {
      :if (([:timestamp] - [:totime $c]) > $v) do={
        /ip hotspot user set $u disabled=yes;
        /ip hotspot active remove [/ip hotspot active find where user=$uname];
        /ip hotspot cookie remove [/ip hotspot cookie find where user=$uname];
      }
    } on-error={}
  }
}
